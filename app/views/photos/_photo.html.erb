<article id="<%= dom_id(photo) %>" class="group">
  <div class="relative aspect-square overflow-hidden rounded-2xl border border-gray-100 bg-gray-100 shadow-sm transition duration-300 group-hover:-translate-y-0.5 group-hover:shadow-xl dark:border-zinc-800 dark:bg-zinc-900" style="background-color: <%= photo.avg_color %>">
    <%= link_to photo_path(photo), class: "block h-full w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-950", aria: { label: "View #{photo.alt}" } do %>
      <%= image_tag photo.src_medium,
        alt: photo.alt,
        class: "h-full w-full object-cover",
        loading: "lazy" %>
    <% end %>

    <div class="absolute right-3 top-3 z-10">
      <%= render "likes/button", photo: photo, liked: liked_photo_ids.include?(photo.id) %>
    </div>
  </div>

  <div class="mt-3.5 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h2 class="truncate text-sm font-medium tracking-tight text-gray-900 dark:text-zinc-100">
        <span class="font-normal text-gray-500 dark:text-zinc-500">By</span>
        <span class="font-semibold"><%= photo.photographer %></span>
      </h2>
      <%= link_to photo.url,
        target: "_blank",
        rel: "noopener noreferrer",
        class: "mt-1.5 inline-flex max-w-full items-center gap-1.5 text-sm font-normal leading-none text-gray-500 transition hover:text-clever-600 dark:text-zinc-400 dark:hover:text-clever-400" do %>
        <%= image_tag "links.svg", alt: "", aria: { hidden: true }, class: "h-4 w-4 shrink-0 opacity-90" %>
        <span class="truncate"><%= photo.url %></span>
      <% end %>
    </div>
  </div>
</article>
