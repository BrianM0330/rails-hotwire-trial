<% content_for :title, "Photos - Clever Real Estate" %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between pb-6 border-b border-gray-100 dark:border-zinc-800 mb-8 transition-colors duration-200">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Private Gallery</h1>
      <p class="mt-2 text-sm text-gray-500 dark:text-zinc-400">Explore curated spaces securely.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10" id="photos">
    <!-- Placeholder for phase 4: Photo cards will be injected here. Airbnb style image grid -->
    <div class="group cursor-pointer">
      <div class="relative aspect-square w-full overflow-hidden rounded-xl bg-gray-100 dark:bg-zinc-800 transition-colors duration-200 border border-transparent dark:border-zinc-700/50">
        <div class="absolute inset-0 bg-gradient-to-tr from-clever-100/50 to-gray-50 dark:from-clever-900/20 dark:to-zinc-800 mix-blend-multiply dark:mix-blend-normal transition group-hover:scale-105 duration-300"></div>
        <div class="absolute top-3 right-3">
          <button aria-label="Like property" class="rounded-full bg-white/70 dark:bg-zinc-900/70 p-2 backdrop-blur-md transition hover:bg-white dark:hover:bg-zinc-900 hover:scale-110 shadow-sm text-gray-400 dark:text-zinc-400 hover:text-red-500 dark:hover:text-red-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500">
            <svg aria-hidden="true" xmlns="http://www.w3.org/polaris/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
          </button>
        </div>
      </div>
      <div class="mt-3 flex justify-between">
        <div>
          <h3 class="text-sm font-medium text-gray-900 dark:text-zinc-200">Sample Property</h3>
          <p class="mt-1 text-sm text-gray-500 dark:text-zinc-400">Placeholder details</p>
        </div>
        <p class="text-sm font-medium text-gray-900 dark:text-zinc-200 text-right"><span class="text-clever-600 dark:text-clever-400">0</span> likes</p>
      </div>
    </div>
    
    <div class="group cursor-pointer">
      <div class="relative aspect-square w-full overflow-hidden rounded-xl bg-gray-100 dark:bg-zinc-800 transition-colors duration-200 border border-transparent dark:border-zinc-700/50">
        <div class="absolute inset-0 bg-gradient-to-tr from-gray-200 to-gray-50 dark:from-zinc-700/50 dark:to-zinc-800 mix-blend-multiply dark:mix-blend-normal transition group-hover:scale-105 duration-300"></div>
        <div class="absolute top-3 right-3">
          <button aria-label="Like property" class="rounded-full bg-white/70 dark:bg-zinc-900/70 p-2 backdrop-blur-md transition hover:bg-white dark:hover:bg-zinc-900 hover:scale-110 shadow-sm text-gray-400 dark:text-zinc-400 hover:text-red-500 dark:hover:text-red-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500">
            <svg aria-hidden="true" xmlns="http://www.w3.org/polaris/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
            </svg>
          </button>
        </div>
      </div>
      <div class="mt-3 flex justify-between">
        <div>
          <h3 class="text-sm font-medium text-gray-900 dark:text-zinc-200">Sample Property</h3>
          <p class="mt-1 text-sm text-gray-500 dark:text-zinc-400">Placeholder details</p>
        </div>
        <p class="text-sm font-medium text-gray-900 dark:text-zinc-200 text-right"><span class="text-clever-600 dark:text-clever-400">0</span> likes</p>
      </div>
    </div>
  </div>
</div>
