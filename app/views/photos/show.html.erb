<% content_for :title, @photo.alt.presence || "Photo" %>
<%= turbo_stream_from @photo %>

<div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
  <%= link_to "Back to gallery", photos_path, class: "text-sm font-medium text-clever-600 hover:text-clever-700 dark:text-clever-400 dark:hover:text-clever-300" %>

  <div class="relative mt-6 overflow-hidden rounded-2xl bg-gray-100 dark:bg-zinc-900" style="background-color: <%= @photo.avg_color %>">
    <%= image_tag @photo.src_large2x,
      alt: @photo.alt,
      class: "h-auto w-full block",
      loading: "lazy" %>
  </div>

  <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white"><%= @photo.alt.presence || "Untitled photo" %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-zinc-400">By <span class="font-medium text-gray-700 dark:text-zinc-300"><%= @photo.photographer %></span></p>
      <div class="relative mt-3 flex max-w-full items-center gap-2" data-controller="copy-source" data-copy-source-url-value="<%= @photo.url %>">
        <button type="button" class="inline-flex shrink-0 cursor-pointer items-center justify-center text-zinc-500 transition hover:text-zinc-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 dark:text-zinc-500 dark:hover:text-zinc-200" data-action="copy-source#copy" aria-label="Copy source URL for photo by <%= @photo.photographer %>">
          <%= inline_svg "copy.svg", css_class: "h-4 w-4", aria: { hidden: true } %>
        </button>
        <span class="hidden absolute -top-8 left-0 rounded-full bg-zinc-950 px-2.5 py-1 text-xs font-medium text-white shadow-sm dark:bg-white dark:text-zinc-950" data-copy-source-target="toast" role="status" aria-live="polite">Copied</span>
        <%= link_to @photo.url,
          target: "_blank",
          rel: "noopener noreferrer",
          class: "inline-flex min-w-0 items-center gap-1.5 text-sm text-zinc-500 transition hover:text-clever-400" do %>
          <%= image_tag "links.svg", alt: "", aria: { hidden: true }, class: "h-4 w-4 shrink-0 opacity-80" %>
          <span class="truncate"><%= @photo.url %></span>
        <% end %>
      </div>
    </div>

    <%= render "likes/button", photo: @photo, liked: @liked_photo_ids.include?(@photo.id) %>
  </div>
</div>
