<% if notice = flash[:notice] %>
  <div class="pointer-events-none fixed inset-x-0 top-20 z-50 flex justify-center px-4 sm:px-6 lg:px-8">
    <div class="pointer-events-auto flex items-center gap-3 rounded-full bg-gray-900/95 px-4 py-3 text-sm font-medium text-white shadow-xl backdrop-blur-sm ring-1 ring-white/10 animate-fade-in-down" id="notice">
      <svg class="h-5 w-5 text-clever-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
      </svg>
      <%= notice %>
    </div>
  </div>
<% end %>

<% if alert = flash[:alert] %>
  <div class="pointer-events-none fixed inset-x-0 top-20 z-50 flex justify-center px-4 sm:px-6 lg:px-8">
    <div class="pointer-events-auto flex items-center gap-3 rounded-full bg-red-600/95 px-4 py-3 text-sm font-medium text-white shadow-xl backdrop-blur-sm animate-fade-in-down" id="alert">
      <svg class="h-5 w-5 text-white/80" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
      </svg>
      <%= alert %>
    </div>
  </div>
<% end %>
