<nav
  aria-label="Main Navigation"
  class="bg-zinc-950 border-b border-white/5 sticky top-0 z-50"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between items-center">
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 rounded-md p-1 -ml-1", aria_label: "Clever Photos Home" do %>
          <img
            src="https://start.listwithclever.com/wp-content/uploads/2024/03/clever-logo-white.png"
            alt=""
            aria-hidden="true"
            class="
              h-6 w-auto object-contain transition-transform group-hover:scale-105
            "
          />
          <div class="h-5 w-px bg-white/10" aria-hidden="true"></div>
          <span
            class="
              text-xl font-medium tracking-tight text-white/90 group-hover:text-white
              transition leading-none mt-0.5
            "
          >Photos</span>
        <% end %>
      </div>

      <div class="flex items-center gap-4">
        <% if authenticated? %>
          <%= link_to "Gallery",
          photos_path,
          class:
            "text-sm font-medium text-zinc-400 hover:text-white transition focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 rounded px-2 py-1" %>
          <div class="h-5 w-px bg-white/10" aria-hidden="true"></div>
          <%= button_to "Sign out",
          logout_path,
          method: :delete,
          class:
            "text-sm font-medium text-zinc-400 hover:text-white transition focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 rounded px-2 py-1" %>
        <% else %>
          <%= link_to "Sign in",
          login_path,
          class:
            "text-sm font-medium text-zinc-400 hover:text-white transition focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 rounded px-2 py-1" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
