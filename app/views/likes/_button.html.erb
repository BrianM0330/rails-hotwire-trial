<div id="<%= dom_id(photo, :like) %>">
  <% icon = liked ? "star-fill.svg" : "star-line.svg" %>
  <% label =
    (
      if liked
        "Unlike photo by #{photo.photographer}"
      else
        "Like photo by #{photo.photographer}"
      end
    ) %>
  <% method = liked ? :delete : :post %>
  <% button_class = [
    "group inline-flex cursor-pointer items-center gap-1.5 rounded-xl px-2.5 py-1.5 text-sm font-semibold shadow-sm ring-1 transition duration-150 ease-out hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 active:scale-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500",
    (
      if liked
        "bg-white/95 text-zinc-950 ring-white/40 hover:bg-zinc-100"
      else
        "bg-zinc-950/80 text-white ring-white/20 hover:bg-zinc-900 hover:ring-white/30"
      end
    ),
  ].join(" ") %>
  <% icon_class =
    (
      if liked
        "h-4.5 w-4.5 shrink-0 text-zinc-950 transition-transform duration-150 ease-out group-active:scale-90"
      else
        "h-4.5 w-4.5 shrink-0 text-white transition-transform duration-150 ease-out group-active:scale-90"
      end
    ) %>

  <%= button_to photo_like_path(photo),
    method: method,
    aria: { label: label, pressed: liked },
    class: button_class do %>
    <%= inline_svg icon,
    css_class: icon_class,
    aria: {
      hidden: true,
    },
    data: {
      icon: icon.delete_suffix(".svg"),
    } %>
    <span
      class="
        tabular-nums transition-transform duration-150 ease-out group-active:scale-95
      "
    ><%= photo.likes_count %></span>
  <% end %>
</div>
