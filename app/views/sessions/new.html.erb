<% content_for :title, "Sign in - Clever Photos" %>

<div class="flex min-h-[80vh] flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Sign in to your account</h2>
    <p class="mt-2 text-center text-sm text-gray-600 dark:text-zinc-400">
      Or
      <%= link_to "create a new account", signup_path, class: "font-medium text-clever-600 dark:text-clever-400 hover:text-clever-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500" %>
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white dark:bg-zinc-900 px-4 py-8 shadow-sm sm:rounded-xl sm:px-10 border border-gray-100 dark:border-zinc-800 transition-colors duration-200">
      <%= form_with url: session_url, class: "space-y-6" do |form| %>
        <div>
          <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-gray-700 dark:text-zinc-300" %>
          <div class="mt-2">
            <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address], class: "input-field" %>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between">
            <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 dark:text-zinc-300" %>
            <div class="text-sm">
              <%= link_to "Forgot password?", new_password_path, class: "font-medium text-clever-600 dark:text-clever-400 hover:text-clever-500 transition rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500" %>
            </div>
          </div>
          <div class="mt-2">
            <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "input-field" %>
          </div>
        </div>

        <div>
          <%= form.submit "Sign in", class: "btn-primary w-full cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
