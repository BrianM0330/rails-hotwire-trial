<% content_for :title, "Gallery Network" %>

<section class="relative isolate overflow-hidden bg-stone-950 text-white">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(245,158,11,0.28),transparent_34%),radial-gradient(circle_at_bottom_right,rgba(14,165,233,0.22),transparent_30%)]"></div>
  <div class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-6 py-8 sm:px-10 lg:px-12">
    <header class="flex items-center justify-between">
      <%= link_to root_path, class: "text-lg font-semibold tracking-tight" do %>
        Gallery Network
      <% end %>

      <div class="rounded-full border border-white/15 px-4 py-2 text-sm text-white/75">
        Early access
      </div>
    </header>

    <div class="grid flex-1 items-center gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
      <div class="max-w-3xl">
        <p class="mb-5 inline-flex rounded-full bg-white/10 px-4 py-2 text-sm font-medium text-amber-100 ring-1 ring-white/15">
          A better home for property-driven photography
        </p>

        <h1 class="text-5xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">
          Photographer and Real-Estate Guru? This is the network for you
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-300 sm:text-xl">
          Showcase spaces, discover sharp visual work, and start building a gallery that connects creative talent with real-estate opportunity.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <%= link_to "Explore the vision", root_path, class: "rounded-full bg-amber-300 px-6 py-3 text-center text-sm font-semibold text-stone-950 shadow-lg shadow-amber-500/20 transition hover:bg-amber-200" %>
          <span class="rounded-full border border-white/15 px-6 py-3 text-center text-sm font-semibold text-white/80">
            Gallery coming soon
          </span>
        </div>
      </div>

      <div class="rounded-[2rem] border border-white/10 bg-white/10 p-3 shadow-2xl shadow-black/30 backdrop-blur">
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="min-h-72 rounded-[1.5rem] bg-gradient-to-br from-amber-200 via-stone-100 to-sky-200 p-5 text-stone-950 sm:row-span-2">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-stone-600">Featured space</p>
            <div class="mt-24 rounded-2xl bg-white/75 p-4 shadow-xl backdrop-blur">
              <p class="text-3xl font-bold">Modern loft</p>
              <p class="mt-2 text-sm text-stone-600">Clean lines, warm light, buyer-ready imagery.</p>
            </div>
          </div>

          <div class="rounded-[1.5rem] bg-stone-900 p-5 ring-1 ring-white/10">
            <p class="text-sm text-stone-400">Photographers</p>
            <p class="mt-3 text-4xl font-bold">Curated</p>
          </div>

          <div class="rounded-[1.5rem] bg-white p-5 text-stone-950">
            <p class="text-sm text-stone-500">Listings</p>
            <p class="mt-3 text-4xl font-bold">Visual-first</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
