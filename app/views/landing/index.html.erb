<% content_for :title, "Clever Photos" %>

<div class="bg-white dark:bg-zinc-950 transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
        The exclusive network for<br/><span class="text-clever-600">premium property photography.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600 dark:text-zinc-400">
        An invite-only platform designed for top-tier photographers to deliver stronger, more attractive listings for Clever Real Estate.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <%= link_to "Join the network", new_user_path, class: "btn-primary text-base px-8 py-3 w-full sm:w-auto" %>
        <%= link_to "Sign in to your gallery", new_session_path, class: "text-sm font-semibold leading-6 text-gray-900 dark:text-zinc-300 hover:text-clever-600 dark:hover:text-clever-400 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-clever-500 rounded px-2 py-1" %>
      </div>
    </div>
  </div>
</div>

<div class="bg-gray-50 dark:bg-zinc-900/50 py-16 sm:py-24 transition-colors duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl lg:max-w-none">
      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Setting the standard</h2>
      
      <div class="mt-6 space-y-12 lg:grid lg:grid-cols-3 lg:gap-x-6 lg:space-y-0">
        <div class="group relative">
          <div class="relative h-80 w-full overflow-hidden rounded-2xl bg-white dark:bg-zinc-800 sm:aspect-h-1 sm:aspect-w-2 lg:aspect-h-1 lg:aspect-w-1 group-hover:opacity-75 sm:h-64 transition shadow-sm border border-gray-100 dark:border-zinc-800">
            <div class="absolute inset-0 bg-gradient-to-br from-clever-100 to-gray-100 dark:from-clever-900/30 dark:to-zinc-800 mix-blend-multiply dark:mix-blend-normal"></div>
          </div>
          <h3 class="mt-6 text-sm text-gray-500 dark:text-zinc-400">
            <span class="absolute inset-0"></span>
            Interior
          </h3>
          <p class="text-base font-semibold text-gray-900 dark:text-zinc-200">Modern loft aesthetics</p>
        </div>
        
        <div class="group relative">
          <div class="relative h-80 w-full overflow-hidden rounded-2xl bg-white dark:bg-zinc-800 sm:aspect-h-1 sm:aspect-w-2 lg:aspect-h-1 lg:aspect-w-1 group-hover:opacity-75 sm:h-64 transition shadow-sm border border-gray-100 dark:border-zinc-800">
            <div class="absolute inset-0 bg-gradient-to-br from-gray-200 to-clever-50 dark:from-zinc-700 dark:to-clever-900/20 mix-blend-multiply dark:mix-blend-normal"></div>
          </div>
          <h3 class="mt-6 text-sm text-gray-500 dark:text-zinc-400">
            <span class="absolute inset-0"></span>
            Architecture
          </h3>
          <p class="text-base font-semibold text-gray-900 dark:text-zinc-200">Natural light spaces</p>
        </div>

        <div class="group relative">
          <div class="relative h-80 w-full overflow-hidden rounded-2xl bg-white dark:bg-zinc-800 sm:aspect-h-1 sm:aspect-w-2 lg:aspect-h-1 lg:aspect-w-1 group-hover:opacity-75 sm:h-64 transition shadow-sm border border-gray-100 dark:border-zinc-800">
            <div class="absolute inset-0 bg-gradient-to-br from-clever-50 to-gray-200 dark:from-clever-900/15 dark:to-zinc-800 mix-blend-multiply dark:mix-blend-normal"></div>
          </div>
          <h3 class="mt-6 text-sm text-gray-500 dark:text-zinc-400">
            <span class="absolute inset-0"></span>
            Detail
          </h3>
          <p class="text-base font-semibold text-gray-900 dark:text-zinc-200">Texture and material</p>
        </div>
      </div>
    </div>
  </div>
</div>
